# =========================================================
# lowkey-artifact-builder generated products
# =========================================================
#
# All generated artifact products are kept beneath this
# directory.
#
# Final products:
#   artifacts/<artifact_id>.3mf
#
# Intermediate products:
#   artifacts/<artifact_id>/<stage>/...
#

artifacts/


